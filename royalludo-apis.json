{
  "info": {
    "name": "Royal Ludo Mobile App & Superadmin API Collection",
    "description": "Complete Postman-ready contract for the Royal Ludo mobile app and admin backend. All responses use a standard envelope: { status, message, data }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kingplayer\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"Royal@123\",\n  \"referralCode\": \"ROYAL50\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Request params: username, mobile, password, referralCode. Response: status, message, data { otpSessionId, otpExpiresInSec }."
          },
          "response": [
            {
              "name": "201 Success",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
              "status": "Created",
              "code": 201,
              "body": "{\n  \"status\": true,\n  \"message\": \"Registration initiated. OTP sent successfully.\",\n  \"data\": {\n    \"otpSessionId\": \"session_64f...\",\n    \"otpExpiresInSec\": 120\n  }\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"Royal@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Request params: mobile, password. Response: status, message, data { accessToken, refreshToken, expiresIn, user { id, username, mobile, role, avatarUrl } }."
          },
          "response": [
            {
              "name": "200 Success",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/login" },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"accessToken\": \"jwt-token\",\n    \"refreshToken\": \"jwt-token\",\n    \"expiresIn\": 2592000,\n    \"user\": {\n      \"id\": \"64f...\",\n      \"username\": \"kingplayer\",\n      \"mobile\": \"9876543210\",\n      \"role\": \"USER\",\n      \"avatarUrl\": null\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Request params: mobile. Response: status, message, data { otpSessionId, otpExpiresInSec }."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpSessionId\": \"session_64f...\",\n  \"otp\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp",
            "description": "Request params: otpSessionId, otp. Response: status, message, data { verified: true }."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpSessionId\": \"session_64f...\",\n  \"otp\": \"1234\",\n  \"newPassword\": \"Royal@1234\",\n  \"confirmPassword\": \"Royal@1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "Request params: otpSessionId, otp, newPassword, confirmPassword. Response: status, message."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Request: bearer token. Response: status, message."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Profile & Stats",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/user/profile",
            "description": "Response: status, message, data { id, username, mobile, avatarUrl, referralCode, stats, wallet { depositBalanceRs, winningBalanceRs, bonusBalanceRs, totalBalanceRs } }."
          },
          "response": []
        },
        {
          "name": "Get User Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/user/stats",
            "description": "Response: status, message, data { totalMatches, wins, losses, winRatePct, totalWinningsRs, avgMatchFeeRs }."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get Wallet",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/wallet",
            "description": "Response: status, message, data { depositBalanceRs, winningBalanceRs, bonusBalanceRs, lockedBalanceRs, totalBalanceRs }."
          },
          "response": []
        },
        {
          "name": "Deposit Initiate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountRs\": 500,\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": "{{baseUrl}}/wallet/deposit/initiate",
            "description": "Request params: amountRs, paymentMethod. Response: status, message, data { transactionId, amountRs, updatedDepositBalanceRs }."
          },
          "response": []
        },
        {
          "name": "Withdraw Initiate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountRs\": 500,\n  \"payoutMethod\": \"UPI\",\n  \"upiId\": \"kingplayer@upi\",\n  \"accountHolderName\": \"King Player\"\n}"
            },
            "url": "{{baseUrl}}/wallet/withdraw/initiate",
            "description": "Request params: amountRs, payoutMethod, upiId or accountNumber/ifscCode, accountHolderName. Response: status, message, data { withdrawalId, amountRs, status }."
          },
          "response": []
        },
        {
          "name": "Wallet Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/wallet/transactions",
            "description": "Response: status, message, data [{ transactionId, type, amountRs, status, description, createdAt }]."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rooms & Match Flow",
      "item": [
        {
          "name": "Browse Rooms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/rooms",
            "description": "Response: status, message, data [room objects] with fields such as roomCode, gameMode, playerCount, entryFee, joinedPlayers, status."
          },
          "response": []
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameMode\": \"CLASSIC\",\n  \"playerCount\": 2,\n  \"entryFeeRs\": 500,\n  \"isPrivate\": false\n}"
            },
            "url": "{{baseUrl}}/rooms",
            "description": "Request params: gameMode, playerCount, entryFeeRs, isPrivate. Response: status, message, data { room object } with roomCode and entry fee deducted from wallet."
          },
          "response": []
        },
        {
          "name": "Submit Match Result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchId\": \"66a01234567890abcdef1111\",\n  \"claimedResult\": \"WON\",\n  \"screenshotUrl\": \"https://images.unsplash.com/...\"\n}"
            },
            "url": "{{baseUrl}}/matches/submit-result",
            "description": "Request params: matchId, claimedResult, screenshotUrl. Response: status, message, data { disputeCreated: true }."
          },
          "response": []
        },
        {
          "name": "Match History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/matches/history",
            "description": "Response: status, message, data [{ id, gameMode, entryFeeRs, prizePoolRs, status, winnerId, players, startedAt }]."
          },
          "response": []
        }
      ]
    },
