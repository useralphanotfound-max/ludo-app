{
  "info": {
    "title": "Royal Ludo Mobile App & Superadmin Complete REST API Collection",
    "version": "1.0.0",
    "description": "Exhaustive Production Specification of all Mobile App Endpoints and Superadmin APIs for Royal Ludo.",
    "baseUrl": "http://localhost:3000/api",
    "superadminLoginUrl": "http://localhost:3000/superadmin/login",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <JWT_ACCESS_TOKEN>"
    }
  },
  "modules": [
    {
      "name": "1. Authentication Module",
      "endpoints": [
        { "name": "Register User", "method": "POST", "path": "/auth/register", "body": { "username": "kingplayer", "mobile": "9876543210", "password": "Royal@123", "referralCode": "ROYAL50" } },
        { "name": "Verify OTP", "method": "POST", "path": "/auth/verify-otp", "body": { "otpSessionId": "session_123", "otp": "1234" } },
        { "name": "User Login", "method": "POST", "path": "/auth/login", "body": { "mobile": "9876543210", "password": "Royal@123" } },
        { "name": "Forgot Password", "method": "POST", "path": "/auth/forgot-password", "body": { "mobile": "9876543210" } },
        { "name": "Reset Password", "method": "POST", "path": "/auth/reset-password", "body": { "otpSessionId": "session_123", "otp": "1234", "newPassword": "Royal@1234", "confirmPassword": "Royal@1234" } },
        { "name": "Logout", "method": "POST", "path": "/auth/logout", "body": {} }
      ]
    },
    {
      "name": "2. User Profile Module",
      "endpoints": [
        { "name": "Get Profile & Sub-Balances", "method": "GET", "path": "/user/profile" },
        { "name": "Get User Gameplay Statistics", "method": "GET", "path": "/user/stats" }
      ]
    },
    {
      "name": "3. Mobile Dashboard Aggregation",
      "endpoints": [
        { "name": "Get Home Dashboard Payload", "method": "GET", "path": "/dashboard" }
      ]
    },
    {
      "name": "4. Wallet & Cashout Module",
      "endpoints": [
        { "name": "Get Sub-Balances", "method": "GET", "path": "/wallet" },
        { "name": "Initiate Deposit", "method": "POST", "path": "/wallet/deposit/initiate", "body": { "amountRs": 500, "paymentMethod": "UPI" } },
        { "name": "Initiate Cashout (100% Net, No TDS, No KYC)", "method": "POST", "path": "/wallet/withdraw/initiate", "body": { "amountRs": 500, "payoutMethod": "UPI", "upiId": "kingplayer@upi", "accountHolderName": "King Player" } },
        { "name": "Transaction History Ledger", "method": "GET", "path": "/wallet/transactions" }
      ]
    },
    {
      "name": "5. Game Rooms Module",
      "endpoints": [
        { "name": "Browse Public Rooms", "method": "GET", "path": "/rooms" },
        { "name": "Create Classic/Turbo Room", "method": "POST", "path": "/rooms", "body": { "gameMode": "CLASSIC", "playerCount": 2, "entryFeeRs": 500, "isPrivate": false } }
      ]
    },
    {
      "name": "6. Matches & Screenshot Disputes",
      "endpoints": [
        { "name": "Submit Match Result & Screenshot", "method": "POST", "path": "/matches/submit-result", "body": { "matchId": "66a01234567890abcdef1111", "claimedResult": "WON", "screenshotUrl": "https://images.unsplash.com/photo-1611996575749-79a3a250f948?w=800&q=80" } },
        { "name": "User Match History", "method": "GET", "path": "/matches/history" }
      ]
    },
    {
      "name": "7. Leaderboards & Rankings",
      "endpoints": [
        { "name": "Get Leaderboard Rankings", "method": "GET", "path": "/leaderboard?period=daily" }
      ]
    },
    {
      "name": "8. Referral System",
      "endpoints": [
        { "name": "My Referral Code & Stats", "method": "GET", "path": "/referral/my-code" }
      ]
    },
    {
      "name": "9. Push Notifications",
      "endpoints": [
        { "name": "Get User Notifications", "method": "GET", "path": "/notifications" }
      ]
    },
    {
      "name": "10. Support & FAQ",
      "endpoints": [
        { "name": "Get Frequently Asked Questions", "method": "GET", "path": "/support/faq" }
      ]
    },
    {
      "name": "11. CMS & App Control",
      "endpoints": [
        { "name": "Force Update Version Check", "method": "GET", "path": "/cms/version-check" },
        { "name": "Terms of Service", "method": "GET", "path": "/cms/terms" }
      ]
    },
    {
      "name": "12. Superadmin Management APIs",
      "endpoints": [
        { "name": "Superadmin Login (IP Logged)", "method": "POST", "path": "/admin/login", "body": { "username": "admin@royalludo.com", "password": "RoyalAdmin@123" } },
        { "name": "Telemetry Dashboard", "method": "GET", "path": "/admin/dashboard" },
        { "name": "Users List", "method": "GET", "path": "/admin/users?search=" },
        { "name": "Manual Wallet Adjust", "method": "POST", "path": "/admin/users/:id/wallet-adjust", "body": { "amountRs": 500, "subBalanceType": "deposit", "actionType": "CREDIT", "reason": "Promotional bonus" } },
        { "name": "User Ban Status Toggle", "method": "PATCH", "path": "/admin/users/:id/status", "body": { "status": "BANNED", "reason": "Terms violation" } },
        { "name": "Pending Withdrawals Queue", "method": "GET", "path": "/admin/withdrawals" },
        { "name": "Approve / Reject Cashout", "method": "POST", "path": "/admin/withdrawals/:id/process", "body": { "action": "APPROVE" } },
        { "name": "Pending Disputes Queue", "method": "GET", "path": "/admin/disputes" },
        { "name": "Resolve Dispute & Award Winner", "method": "POST", "path": "/admin/disputes/:id/resolve", "body": { "decision": "P1_WIN", "adminNotes": "Screenshot evidence verified." } },
        { "name": "System Game Settings", "method": "GET & PUT", "path": "/admin/settings", "body": { "platformCommissionPct": 10, "maintenanceMode": false } },
        { "name": "Exact IP Audit Trail Logs", "method": "GET", "path": "/admin/audit-logs" }
      ]
    }
  ]
}
