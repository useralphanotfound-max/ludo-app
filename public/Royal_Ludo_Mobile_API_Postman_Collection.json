  "item": [
    {
      "name": "1. Authentication",
      "description": "APIs for Mobile Login, Registration with OTP (default 1234), optional Referral Code, and Token Refresh. Auto-saves access_token.",
      "item": [
        {
          "name": "Direct Password Login (Auto-Saves Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.data.access_token);",
                  "    if (jsonData.data.refresh_token) pm.collectionVariables.set('refresh_token', jsonData.data.refresh_token);",
                  "    console.log('✅ Access Token automatically set to collection variable access_token!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9182279729\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user using mobile number and password. Automatically sets the collection variable `access_token` upon success."
